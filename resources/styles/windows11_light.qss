/* =============================================================================
 * ScreenKiller - Soft Lavender & Cream Theme
 * 主色调：柔和蓝紫色（Lavender）+ 奶白色（Cream）拼接样式
 *
 * 调色板：
 *   奶白基调   #FBF7EF   主背景
 *   奶白浅     #FDFAF3   工具栏顶部
 *   奶白深     #F5EDDF   工具栏底部 / 状态栏
 *   米色分隔   #E5D9C5   分隔线
 *   米色边框   #D9CFC1   通用边框
 *   蓝紫主色   #8B7AB8   主操作色
 *   蓝紫深     #6B5B95   按下 / 选中
 *   蓝紫更深   #4A3F6E   深色文字
 *   蓝紫浅     #B5A5D1   悬停边框
 *   蓝紫更浅   #D4C9E8   悬停背景
 *   蓝紫极浅   #E4D9F0   悬停渐变
 *   深紫文字   #3A3357   主文字色
 *   暗紫灰     #8C8499   禁用文字
 * =============================================================================
 */

/* ---------- 全局 ---------- */
* {
    /* 字体栈：Fira Code 优先匹配英文/数字/代码字符（支持连写），
     * 中文字符在 Fira Code 中缺失时回退到霞鹜文楷 Lite，
     * 再兜底微软雅黑 / Segoe UI。 */
    font-family: "Fira Code", "LXGW WenKai Lite", "Microsoft YaHei UI", "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 18px;
    outline: none;
}

QWidget {
    background: #FBF7EF;
    color: #3A3357;
}

/* 引导面板：子控件透明背景，让面板的半透明自绘背景透出
 * 注意：全局 QWidget 规则会被 QLabel 继承，若不覆盖则子控件
 * 的不透明背景色会盖住 GuidePanel 的 paintEvent 半透明圆角。 */
QWidget#guidePanel,
QWidget#guidePanel QLabel {
    background: transparent;
}

/* 消息框：弹窗字号 14px，避免继承全局 18px 导致弹窗文字偏大
 * 仅限定 QMessageBox 内部的标签与按钮，不影响工具栏等普通按钮。 */
QMessageBox QLabel,
QMessageBox QPushButton {
    font-size: 14px;
}

QWidget:disabled {
    color: #9B92A8;
}

QMainWindow,
QDialog {
    background: #FBF7EF;
}

/* ---------- 工具栏 ---------- */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FDFAF3,
        stop:1 #F5EDDF);
    border: none;
    border-bottom: 1px solid #D9CFC1;
    padding: 4px 8px;
    spacing: 4px;
}

QToolBar::separator {
    background: #E5D9C5;
    width: 1px;
    height: 22px;
    margin: 0 4px;
}

/* ---------- 可拖拽间隔区域（透明背景，继承工具栏渐变） ---------- */
QWidget#dragHandle {
    background: transparent;
    border: none;
}

/* ---------- 工具按钮（通用） ---------- */
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 14px;
    color: #3A3357;
    min-height: 22px;
}

QToolButton:hover {
    background: #E4D9F0;
    border: 1px solid #B5A5D1;
}

QToolButton:pressed,
QToolButton:checked,
QToolButton:on {
    background: #B5A5D1;
    border: 1px solid #8B7AB8;
    color: #FFFFFF;
}

QToolButton:disabled {
    color: #B5ACBC;
    background: transparent;
    border: 1px solid transparent;
}

QToolButton::menu-indicator {
    image: url(:/icons/drop_down.png);
    subcontrol-position: right bottom;
    width: 8px;
    height: 8px;
}

QToolButton::menu-indicator:open {
    image: url(:/icons/drop_down_clicked.png);
    subcontrol-position: right bottom;
}

/* ---------- 主截屏按钮（蓝紫强调） ---------- */
QToolButton#captureButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #9B8AC8,
        stop:1 #6B5B95);
    color: #FFFFFF;
    border: 1px solid #5A4B85;
    font-weight: 600;
    padding: 8px 18px;
}

QToolButton#captureButton:hover {
    background: #7B6BA5;
    border: 1px solid #5A4B85;
}

QToolButton#captureButton:pressed {
    background: #4A3F6E;
}

/* ---------- 保存按钮（使用通用 QToolButton 样式） ---------- */
/* 仅截屏按钮为蓝紫色强调，保存按钮恢复为一般按钮 */

/* ---------- 模式下拉按钮 ---------- */
QToolButton#modeButton {
    padding: 6px 12px;
    color: #3A3357;
}

QToolButton#modeButton:hover {
    background: #E4D9F0;
    border: 1px solid #B5A5D1;
}

QToolButton#modeButton:pressed,
QToolButton#modeButton:checked,
QToolButton#modeButton:on {
    background: #B5A5D1;
    border: 1px solid #8B7AB8;
    color: #FFFFFF;
}

/* ---------- 最小化 / 关闭按钮 ---------- */
QToolButton#minimizeButton,
QToolButton#closeButton {
    padding: 6px 10px;
    min-width: 28px;
}

QToolButton#minimizeButton:hover {
    background: #E4D9F0;
    border: 1px solid #B5A5D1;
}

QToolButton#minimizeButton:pressed {
    background: #B5A5D1;
    border: 1px solid #8B7AB8;
}

QToolButton#closeButton:hover {
    background: #C89898;
    border: 1px solid #A87878;
    color: #6A1F1F;
}

QToolButton#closeButton:pressed {
    background: #A87878;
    border: 1px solid #886868;
    color: #FFFFFF;
}

/* ---------- 菜单 ---------- */
QMenu {
    background: #FDFAF3;
    border: 1px solid #D9CFC1;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 4px;
    color: #3A3357;
}

QMenu::item:selected {
    background: #E4D9F0;
    color: #4A3F6E;
}

QMenu::separator {
    height: 1px;
    background: #E5D9C5;
    margin: 4px 8px;
}

QMenu::indicator:checked {
    image: none;
    background: #6B5B95;
    width: 8px;
    height: 8px;
    margin-left: 8px;
    border-radius: 4px;
}

/* ---------- 标注视口 ---------- */
QGraphicsView#annotationView {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FDFAF3,
        stop:1 #F5EDDF);
    border: 1px solid #D9CFC1;
    border-radius: 8px;
    padding: 4px;
    /* 确保子控件（GuidePanel）不被视口边框和内边距遮挡 */
    /* padding 仅影响内部布局，叠加的浮动面板需在 move 时避开此区域 */
}

QLabel#placeholderLabel {
    color: #6B5B95;
    font-size: 21px;
    font-weight: 500;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FBF7EF,
        stop:1 #E8DEF5);
    border: 1px dashed #B5A5D1;
    border-radius: 12px;
    padding: 32px;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #C9BEDC;
    border: 2px solid transparent;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #A594D1;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #C9BEDC;
    border: 2px solid transparent;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #A594D1;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ---------- 输入对话框 ---------- */
QLineEdit {
    background: #FFFFFF;
    border: 1px solid #D9CFC1;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #8B7AB8;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 1px solid #8B7AB8;
    background: #FDFAF3;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FDFAF3,
        stop:1 #F5EDDF);
    border: 1px solid #D9CFC1;
    border-radius: 6px;
    padding: 6px 16px;
    color: #3A3357;
}

QPushButton:hover {
    background: #E4D9F0;
    border: 1px solid #B5A5D1;
}

QPushButton:pressed {
    background: #B5A5D1;
}

QPushButton:default {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #9B8AC8,
        stop:1 #6B5B95);
    color: #FFFFFF;
    border: 1px solid #5A4B85;
}

/* ---------- 系统托盘提示 ---------- */
QToolTip {
    background: #FDFAF3;
    color: #3A3357;
    border: 1px solid #D9CFC1;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background: #F5EDDF;
    border-top: 1px solid #D9CFC1;
    color: #6B5B95;
}

QStatusBar::item {
    border: none;
}
