root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,cc,cxx}]
indent_size = 4

[*.{json,qrc,ui}]
indent_size = 4

[*.{cmake,CMakeLists.txt}]
indent_size = 4

[*.qss]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
