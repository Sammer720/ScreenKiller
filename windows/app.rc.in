// ScreenKiller Windows 资源文件
// 本文件是模板：构建时由 CMake 的 configure_file 代入版本号生成 app.rc
// 版本号唯一来源为 CMakeLists.txt 的 project(VERSION ...)，改版本只改一处
#pragma code_page(65001)
#include <windows.h>

// 应用程序图标（多尺寸 ICO 容器，16-256px）
IDI_APP_ICON ICON "@PROJECT_SOURCE_DIR@/resources/icons/app.ico"

// 版本信息（FILEVERSION/PRODUCTVERSION 与 FileVersion/ProductVersion 字符串均由 CMake 代入，保证一致）
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Sammer"
            VALUE "FileDescription", "Windows 长截屏与图像标注工具"
            VALUE "FileVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
            VALUE "InternalName", "ScreenKiller"
            VALUE "LegalCopyright", "Copyright (c) 2026 Sammer"
            VALUE "OriginalFilename", "ScreenKiller.exe"
            VALUE "ProductName", "ScreenKiller"
            VALUE "ProductVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END